{
  "name": "Mon CAMP",
  "short_name": "Mon CAMP",
  "id": "/",
  "description": "Application du Camp de District 3 en 1 — Garango 2026",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "tabbed",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#5e013c",
  "theme_color": "#ff6500",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "education",
    "social"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "screenshot-1.png",
      "sizes": "720x1576",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Accueil du Camp de District 3 en 1"
    },
    {
      "src": "screenshot-2.png",
      "sizes": "720x1576",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "CUFLB : Coupe d'Unité Flambeaux-Lumières de Bouaflé"
    }
  ],
  "shortcuts": [
    {
      "name": "CUFLB",
      "short_name": "CUFLB",
      "description": "Coupe d'Unité Flambeaux-Lumières de Bouaflé",
      "url": "./index.html?page=cuflb",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mon ticket",
      "short_name": "Ticket",
      "description": "Ouvrir mon ticket du Camp",
      "url": "./index.html?page=ticket",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+campdistrict",
      "url": "./index.html?lien=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Compte à rebours du Camp",
      "short_name": "Camp",
      "description": "Camp de District 3 en 1 — Garango 2026",
      "tag": "camp-countdown",
      "ms_ac_template": "widget-template.json",
      "data": "widget-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auto_update": false,
      "screenshots": [
        {
          "src": "screenshot-1.png",
          "sizes": "720x1576",
          "type": "image/png",
          "label": "Compte à rebours du Camp"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "./index.html?page=note"
  },
  "related_applications": [
    {
      "platform": "play",
      "id": "app.vercel.camp_district_3_en_1_2026.twa"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://camp-district-3-en-1-2026.vercel.app"
    }
  ],
  "tab_strip": {
    "home_tab": "auto",
    "new_tab_button": {
      "url": "./index.html"
    }
  }
}